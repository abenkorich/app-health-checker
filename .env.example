# Required before the board or its API will open. Same idea as SITE_CUSTOMIZER_SECRET.
# Checks and email keep running while the page is locked.
STATUS_SECRET=ZPjhimcQPrt1i06ncHe5rP/3icdwgXVA

# How often this app re-probes the others. These values seed the first run.
# Settings saved on the board (stored in .status/config.json) override them.
STATUS_POLL_MS=30000
PROBE_TIMEOUT_MS=3000

# Set a value to "off" to hide that app on the first run. After Settings is saved, edit apps there.
PLATFORM_HEALTH_URL=http://127.0.0.1:3000/health
PLATFORM_READY_URL=http://127.0.0.1:3000/health/ready
STOREFRONT_HEALTH_URL=http://127.0.0.1:3001/api/health
STOREFRONT_HOME_URL=http://127.0.0.1:3001/
POS_HEALTH_URL=http://127.0.0.1:3002/api/health
POS_HOME_URL=http://127.0.0.1:3002/
CONSOLE_HEALTH_URL=http://127.0.0.1:3003/api/health
CONSOLE_HOME_URL=http://127.0.0.1:3003/
LMS_HEALTH_URL=http://127.0.0.1:3004/api/health
LMS_HOME_URL=http://127.0.0.1:3004/

# Email when a service goes down. Same SMTP settings as the platform.
# Alerts stay off until ALERT_EMAIL_TO is set. A still-down service is reminded every 15 minutes.
ALERT_EMAIL_TO=ops@example.com
ALERT_REMIND_MS=900000
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=App Health Checker <status@example.com>
